; Адреса, порты и пароли этого стенда. Скопировать в stand.ini (он в
; .gitignore: репозиторий публичный, а имена портов, адреса и пароли опознают
; конкретное железо и конкретную сеть).
[metf]
; Адрес платы в сети стенда. Она же печатает его при подключении в консоль USB
; и отдаёт в GET /wifi.
host = 192.168.1.50

[atboard]
; Порт NodeMCU с прошивкой ESP-AT. Имя разъёма у macOS выглядит так:
port = /dev/cu.usbmodemXXXX

[network]
; Сеть, в которую тест возвращает плату через портал. Если не задана, берётся
; из secrets.ini (wifi_ssid / wifi_password) - там она и так есть для сборки.
; ssid =
; password =

[router]
; Управляемый роутер стенда: WT32-ETH01 с прошивкой esp32_nat_router. Без него
; тесты бед пользователя (test_router.py) пропускаются, портал проверяется.
;
; Адрес платы в проводной сети: консоль слушает TCP 2323 там, а не на своей
; точке доступа - команда `ap disable` иначе отрезала бы управление.
host = 192.168.1.20
; Пароль консоли; он же пароль веб-интерфейса платы.
password =
; Пароль её точки доступа. У роутера не прочитать - `show config` печатает
; звёздочки, - а без него не вернуть точку в исходное состояние после теста.
ap_password =
